# Knobs for task 15. Edit, then re-run `make dev T=15-compaction-and-state R="producer api"`.
# From the host, pass them inline instead: APPLY_DELAY=10ms go run ./tasks/15-compaction-and-state -role api

# producer: one change per INTERVAL to a random one of CUSTOMERS keys
CUSTOMERS=200
INTERVAL=20ms
# % of changes to an existing customer that delete it (tombstone + customer.deleted event)
DELETE_PCT=3

# api: per-record sleep while bootstrapping, to pretend the table is big (0 = off)
APPLY_DELAY=0

# inspect: topic to scan, and re-scan every WATCH (0 = once)
TOPIC=t15.customers
WATCH=0
