# Knobs for task 02. Edit, then re-run `make dev T=02-keys-and-ordering R="producer consumer"`.
# From the host, pass them inline instead: KEY_BY=none go run ./tasks/02-keys-and-ordering -role producer

TOPIC=t02.orders
# partition count used only when the topic is created
PARTITIONS=3
# how fast producer and consumer notice new partitions (franz-go and Java default: 5m)
METADATA_MAX_AGE=10s

# producer: order | merchant | merchant-salted | none (null key)
KEY_BY=order
RATE=200
# orders in flight at once; more = each order's events are further apart in time
ACTIVE_ORDERS=1000
MERCHANTS=50
# % of orders that belong to merchant m-000, the one huge tenant
HOT_MERCHANT_PCT=0
# merchant-salted: how many keys the hot merchant is spread over
SALT=8

# consumer
GROUP=t02.fulfillment
# simulated work per record, to build lag (10ms caps one consumer at ~100 records/s)
PROCESS_TIME=0
# warnings printed per stats interval; the counters are always complete
LOG_VIOLATIONS=10
STATS_EVERY=5s

# inspect: the recent window used for SHARE and skew
WINDOW=1m

# partition-of: keys to place and partition counts to compare (also the history CHECK_TOPIC tries)
KEYS=ord-1,ord-2,ord-3,ord-4,ord-5,ord-6,ord-7,ord-8,m-000,m-001
COUNTS=3,6
