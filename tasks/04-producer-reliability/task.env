# Knobs for task 04. Edit, then re-run `make dev T=04-producer-reliability R=producer`.
# From the host, pass them inline instead: LINGER=50ms go run ./tasks/04-producer-reliability -role bench
# Empty producer knobs keep the franz-go default, noted in brackets.

# producer and bench
# [10ms]
LINGER=
# none | gzip | snappy | lz4 | zstd  [snappy, falling back to none]
COMPRESSION=
# max uncompressed batch size in bytes  [1000012]
BATCH_MAX_BYTES=
# max records buffered in the client before Produce blocks  [50000]
MAX_BUFFERED=
# how long a record may wait for an ack  [unlimited]
DELIVERY_TIMEOUT=30s
# bytes of text in each event
VALUE_SIZE=200

# producer: records/s (0 = as fast as possible)
RATE=2000
# true: Flush (bounded by SHUTDOWN_TIMEOUT) before Close; false: Close right away
FLUSH_ON_EXIT=true
SHUTDOWN_TIMEOUT=10s
# block: Produce waits when the buffer is full | shed: TryProduce fails fast with ErrMaxBuffered
BACKPRESSURE=block
# detached: records survive the signal until the flush deadline | signal: the bug from experiment D
PRODUCE_CTX=detached
STATS_EVERY=1s

# bench (writes to t04.bench)
BENCH_N=200000
# records/s, 0 = as fast as possible
BENCH_RATE=0

# count: how many of the most recent producer runs to show
LAST_RUNS=10
