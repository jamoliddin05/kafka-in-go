# Knobs for task 01. Edit, then re-run `make dev T=01-the-log R="producer consumer"`.
# From the host, pass them inline instead: FROM=ago:1m go run ./tasks/01-the-log -role consumer

# producer: t01.events or t01.short-retention
TOPIC=t01.events
INTERVAL=500ms

# consumer (a group-less reader): start | end | offset:<n> | ago:<duration>
FROM=start
# -1 = all partitions; FROM=offset:<n> only makes sense with one partition
PARTITION=-1
