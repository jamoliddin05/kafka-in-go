# Knobs for task 03. Edit, then re-run `make dev T=03-acks-and-durability R="producer consumer"`.
# From the host, pass them inline instead: ACKS=leader go run ./tasks/03-acks-and-durability -role producer

# t03.payments (RF=3) | t03.strict (min.insync.replicas=3) | t03.rf1 (RF=1)
TOPIC=t03.payments

# producer: all | leader | none
ACKS=all
RATE=500
# how long a record may wait for an ack before its promise fails; 0 = franz-go default (forever)
DELIVERY_TIMEOUT=15s
# fail after this many produce attempts with the broker's own error; 0 = franz-go default (unlimited)
RECORD_RETRIES=0
# franz-go defaults to 10ms; 0 so the latency you see is the cost of acks, not of batching
LINGER=0
STATS_EVERY=1s

# consumer (the data-loss detector)
GROUP=t03.audit

# inspect: repeat every WATCH (e.g. 1s) while you stop brokers; 0 = once
WATCH=0
