# Knobs for task 05. Edit, then re-run `make dev` / `make scale`: compose recreates the containers.
# From the host, pass them inline instead: BALANCER=range go run ./tasks/05-consumer-groups -role consumer

# franz-go's own logs: info shows every join, sync, assign and revoke. Set warn to quiet them.
KAFKA_LOG_LEVEL=info

# producer: records per second into t05.orders (6 partitions)
RATE=50

# consumer
GROUP=t05.billing
# cooperative-sticky (franz-go default) | sticky | range | roundrobin
BALANCER=cooperative-sticky
# classic | consumer (KIP-848: the broker assigns; roundrobin stays classic)
GROUP_PROTOCOL=classic
# simulated work per record, plus once per non-empty poll (a bulk write)
PROCESS_TIME=5ms
BATCH_TIME=0s
MAX_POLL_RECORDS=500
STATS_EVERY=5s

# watch (from the host): refresh period, 0 = print once
EVERY=2s
