# Knobs for task 14. Edit, then re-run `make dev T=14-schema-evolution R=producer`:
# compose recreates the container when this file changes.
# From the host, pass them inline instead: VERSION=v2 go run ./tasks/14-schema-evolution -role producer

# The release this process plays: v1 | v2 | v3. Used by the dev slots (producer, consumer).
# The workers ignore it: make workers/rollout V=... sets theirs.
VERSION=v1

# producer: one order every INTERVAL
INTERVAL=500ms

# consumer and replay: true = json DisallowUnknownFields (experiment C)
STRICT=false
# consumer: how often to log the summary line
SUMMARY_EVERY=10s
