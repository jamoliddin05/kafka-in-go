# Knobs for task 12. Edit, then re-run `make dev T=12-exactly-once R="producer processor consumer"`.
# From the host, pass them inline instead: CRASH_PCT=10 go run ./tasks/12-exactly-once -role processor

# producer: one transfer every INTERVAL between ACCOUNTS accounts
INTERVAL=250ms
ACCOUNTS=10

# processor
# chance per poll batch to die (os.Exit) between the debit and the credit of one transfer
CRASH_PCT=0
# chance per transaction to abort after the records are written (solution only)
FAIL_PCT=0
# keep every transaction open this long before committing, e.g. 20s (solution only)
SLOW_TX=0s
# default t12-processor-$INSTANCE; INSTANCE defaults to the hostname (solution only)
TRANSACTIONAL_ID=
# franz-go default 40s; the broker caps it at transaction.max.timeout.ms (15m)
TX_TIMEOUT=40s
# 45s is the default; short here so a crashed member's partitions move quickly
SESSION_TIMEOUT=10s
# max records per poll = per transaction
MAX_POLL=100

# consumer (the auditor): read_committed | read_uncommitted
ISOLATION=read_committed
REPORT=2s
# how long a transfer may show only one leg before it counts as incomplete
GRACE=5s

# txns tool: 0 = print once, 1s = repeat every second
EVERY=0
