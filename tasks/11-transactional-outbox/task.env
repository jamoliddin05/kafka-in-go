# Knobs for task 11. Edit, then re-run `make dev T=11-transactional-outbox R="api relay consumer"`
# (compose recreates the containers when their env changes).
# From the host, pass them inline instead: WRITE_MODE=outbox go run ./tasks/11-transactional-outbox -role api

# api: db-first | kafka-first (the two naive dual writes) | outbox (TODO 11.1)
WRITE_MODE=db-first
# % of requests that "die" between their two writes
FAIL_PCT=10

# relay (TODO 11.2)
BATCH=100
POLL_INTERVAL=500ms
# every Nth published batch "crashes" after the produce, before its rows are marked; 0 = never
CRASH_BEFORE_MARK=0
# upper bound for one ProduceSync while the batch's rows are locked
PRODUCE_TIMEOUT=10s
RESTART_DELAY=2s

# load tool (run from the host): ORDERS requests, CONCURRENCY at a time
ORDERS=200
CONCURRENCY=8
API_URL=http://localhost:8080
