# Knobs for task 13. Edit, then re-run `make dev T=13-concurrency-and-lag R="producer consumer"`.
# From the host, pass them inline instead: MODE=per-key go run ./tasks/13-concurrency-and-lag -role consumer

# producer: RATE records/s over USERS keys; HOT_PCT % of all records go to user-0
RATE=1000
USERS=1000
HOT_PCT=0

# consumer: sequential | per-partition | per-key | unordered
MODE=sequential
# goroutines for per-key and unordered (per-partition runs one per assigned partition)
WORKERS=64
# simulated I/O per record; the real duration is 0.5x..1.5x of this
PROCESS_TIME=20ms
# max records per poll
MAX_POLL=500
# pause a partition at this many records in flight, resume at half
MAX_INFLIGHT=500
COMMIT_INTERVAL=1s
REPORT=2s
# consumer group (also read by the lag tool)
GROUP=t13.consumer

# lag tool: refresh interval, 0 = print once
EVERY=1s
