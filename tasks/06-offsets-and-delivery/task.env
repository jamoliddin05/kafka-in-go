# Knobs for task 06. Edit, then re-run `make dev T=06-offsets-and-delivery R="producer consumer"`.
# From the host, pass them inline instead: MODE=at-most-once CRASH_EVERY=600 go run ./tasks/06-offsets-and-delivery -role consumer
# Run ONE consumer per group: the ledger that counts duplicates and losses lives in that process.

# producer: payments per second into t06.payments (3 partitions)
RATE=100

# consumer
GROUP=t06.ledger
# autocommit (franz-go default) | greedy | marks | at-most-once | at-least-once
MODE=autocommit
# where a partition WITHOUT a committed offset starts: earliest (franz-go default) | latest (Java default) | none
START=earliest
# simulated kill -9 after 0.5x..1.5x this many records (0 = never); the ledger survives, the client does not
CRASH_EVERY=0
RESTART_AFTER=1s
# a crashed member keeps its partitions this long; the broker allows 6s..30m (default 45s)
SESSION_TIMEOUT=10s
AUTOCOMMIT_INTERVAL=5s
# simulated work per record; MAX_POLL_RECORDS caps one batch (Java max.poll.records)
PROCESS_TIME=2ms
MAX_POLL_RECORDS=100
REPORT_EVERY=5s

# reset (host only): start | end | ago:<duration>; a dry run unless EXECUTE=true
TO=ago:5m
EXECUTE=false
FORCE=false
