# Knobs for task 08. Edit, then re-run `make dev T=08-tracing R="api processor consumer"`.
# From the host, pass them inline: LINK=true go run ./tasks/08-tracing -role processor
# (kit names the services t08-* and exports plaintext to localhost:4317 by default.)

# processor/consumer: false = the process span is a child of the producer span (one trace end to end)
#                     true  = every hop starts a new trace with a span link back to the producer
LINK=false

# manual = your code in tracing.go; kotel = franz-go's plugin/kotel hooks (step 08.5, in the solution)
TRACER=manual

# Standard OTel SDK variables work too, e.g. sample 25% at the api only:
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25
