# Knobs for task 09. Edit, then re-run `make dev T=09-retries-and-dlq R="producer consumer processor"`.
# From the host, pass them inline: POISON_PCT=5 go run ./tasks/09-retries-and-dlq -role producer

# producer
INTERVAL=200ms
# % of orders that an upstream "v2" service sends with amount_cents as a string: poison pills
POISON_PCT=1
# % of orders the payment gateway answers with 503 for TRANSIENT_FOR after they were created
TRANSIENT_PCT=10
TRANSIENT_FOR=3s
# number of distinct keys (customers)
CUSTOMERS=12

# consumer: in-place retries for transient errors before the record goes to the retry topic
LOCAL_RETRIES=2
LOCAL_BACKOFF=200ms

# processor (retry worker): trips through t09.orders.retry before the DLQ.
# Delays are RETRY_BACKOFF * 2^(attempt-1), capped at MAX_BACKOFF, plus up to 20% jitter: 1s 2s 4s 8s.
MAX_ATTEMPTS=4
RETRY_BACKOFF=1s
MAX_BACKOFF=30s

# consumer + processor: the hotfix that accepts "19.99" amounts. Deploy it, then redrive.
LENIENT_AMOUNT=false

# redrive tool (run from the host)
DRY_RUN=false
MAX_REDRIVES=3

# lag tool (run from the host): GROUP=t09.orders (default) | t09.orders.retry | t09.redrive,
# WATCH=5s to repeat
