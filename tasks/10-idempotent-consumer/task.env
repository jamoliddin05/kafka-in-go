# Knobs for task 10. Edit, then re-run `make dev T=10-idempotent-consumer R=consumer`
# (compose recreates the container when its env changes).
# From the host, pass them inline instead: INBOX=true go run ./tasks/10-idempotent-consumer -role consumer

# producer (usually run from the host): COUNT deposits at RATE per second, then exit; COUNT=0 = forever
COUNT=2000
RATE=50
ACCOUNTS=10
# % of deposits an "upstream" publishes a second time with the same event_id
DUP_PCT=5

# consumer
# TODO(10.1): dedupe by event_id in the same transaction as the balance update
INBOX=false
# TODO(10.2): keep the group's offsets in Postgres, in that same transaction
OFFSETS_IN_DB=false
# every run of the consumer "crashes" right after its Nth DB commit, before the
# Kafka offset commit, then restarts in-process after RESTART_DELAY; 0 = never
CRASH_AFTER_DB=250
# commit offsets to Kafka after every N handled records, and when idle
COMMIT_EVERY=100
RESTART_DELAY=2s

# cleanup tool, TODO(10.3)
INBOX_RETENTION=24h
