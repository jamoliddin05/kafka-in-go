# Knobs for task 16. Edit, then re-run `make dev T=16-share-groups R="producer consumer"`.
# From the host, pass them inline instead: STALL_PCT=5 go run ./tasks/16-share-groups -role consumer

# share group used by consumer, config and inspect (change it to watch a brand-new group start at "latest")
GROUP=t16.workers

# producer: one job per INTERVAL, COUNT jobs (0 = forever)
INTERVAL=100ms
COUNT=0
# % of jobs that can never succeed (truncated JSON) -> the worker REJECTs them
POISON_PCT=2
# % of flaky jobs that fail on their first 1..6 deliveries -> RELEASE, redelivered
TRANSIENT_PCT=10

# consumer
# time spent on one job
WORK=200ms
# ShareMaxRecords: records acquired per fetch; each one is locked to you until acked
MAX_RECORDS=5
# % chance per record to os.Exit while holding the rest of the batch (process dies, TCP closes)
CRASH_PCT=0
# % chance per record to hang for STALL without polling or acking (GC pause, stuck call)
STALL_PCT=0
STALL=45s

# config role (one-shot): where a share-partition starts when it has no state yet
RESET=earliest
# optional group overrides: lock 15000..60000 ms, delivery limit 2..10 (broker bounds)
LOCK_MS=
DELIVERY_LIMIT=
