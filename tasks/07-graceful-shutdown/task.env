# Knobs for task 07. The workers (make workers / rollout) and the dev producer read this file;
# compose recreates the containers when it changes. From the host, pass them inline instead:
# STATIC_MEMBERSHIP=true INSTANCE=worker-a ./t07 -role consumer

# franz-go's own logs: info shows joins, syncs, generations, revokes and "leaving group"
KAFKA_LOG_LEVEL=info

# producer: jobs per second into t07.jobs
RATE=10

# worker (role consumer): how long one job takes, and how many jobs one poll may return
PROCESS_TIME=100ms
MAX_POLL=10
# how long the in-flight batch may keep running after SIGTERM; keep it well below STOP_GRACE
SHUTDOWN_TIMEOUT=20s
# static membership: group.instance.id = INSTANCE (worker-a/b/c in compose)
STATIC_MEMBERSHIP=false
# classic protocol only; KIP-848 groups take it from the broker (group.consumer.session.timeout.ms)
SESSION_TIMEOUT=45s
# classic | consumer (KIP-848, broker-side assignment)
GROUP_PROTOCOL=classic
# cooperative-sticky | range (range is eager: every rebalance revokes everything)
BALANCER=cooperative-sticky
# changing this in a rollout is experiment I
GROUP=t07.workers

# audit (run from the host): which jobs to look at, and what counts as a stall
SINCE=5m
STALL=1s
